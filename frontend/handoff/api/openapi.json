  "components": {
    "schemas": {
      "AdaptivePolicy": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "real_discount_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "minimum": -20.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Real Discount Percent",
            "default": "0"
          },
          "buffer_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Buffer Percent",
            "default": "0"
          },
          "terminal_real_balance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Terminal Real Balance",
            "default": "0"
          },
          "max_monthly_restoration_points": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Max Monthly Restoration Points",
            "default": "100"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdaptivePolicy"
      },
      "CollegePlanRequest": {
        "properties": {
          "payment_inputs": {
            "$ref": "#/components/schemas/PaymentRequest"
          },
          "annual_inflation_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": -50.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Annual Inflation Percent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "payment_inputs",
          "annual_inflation_percent"
        ],
        "title": "CollegePlanRequest"
      },
      "EvaluationRequest": {
        "properties": {
          "funding": {
            "$ref": "#/components/schemas/FundingRequest"
          },
          "portfolio": {
            "$ref": "#/components/schemas/PortfolioSettings"
          },
          "stress": {
            "$ref": "#/components/schemas/StressSettings"
          },
          "use_historical_proxy_returns": {
            "type": "boolean",
            "title": "Use Historical Proxy Returns",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "funding",
          "portfolio"
        ],
        "title": "EvaluationRequest"
      },
      "FundingRequest": {
        "properties": {
          "payment_inputs": {
            "$ref": "#/components/schemas/PaymentRequest"
          },
          "opening_balance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Opening Balance"
          },
          "college_annual_return_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": -100.0
              },
              {
                "type": "string"
              }
            ],
            "title": "College Annual Return Percent"
          },
          "support_annual_return_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": -100.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Support Annual Return Percent"
          },
          "annual_cost_percent": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Annual Cost Percent",
            "default": "0"
          },
          "annual_cpi_change_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": -50.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Annual Cpi Change Percent"
          },
          "reserve_transfer_rule": {
            "type": "string",
            "const": "protect_before_payments",
            "title": "Reserve Transfer Rule",
            "default": "protect_before_payments"
          },
          "include_horizon_day_payments": {
            "type": "boolean",
            "const": true,
            "title": "Include Horizon Day Payments",
            "default": true
          },
          "portfolio_source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PortfolioSettings"
              },
              {
                "type": "null"
              }
            ]
          },
          "adaptive_policy": {
            "$ref": "#/components/schemas/AdaptivePolicy"
          },
          "opening_transaction_cost": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Opening Transaction Cost",
            "default": "0"
          },
          "initial_college_shock_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": -100.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Initial College Shock Percent",
            "default": "0"
          },
          "initial_support_shock_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": -100.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Initial Support Shock Percent",
            "default": "0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "payment_inputs",
          "opening_balance",
          "college_annual_return_percent",
          "support_annual_return_percent",
          "annual_cpi_change_percent"
        ],
        "title": "FundingRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentRequest": {
        "properties": {
          "model_start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Start Date"
          },
          "family_mode": {
            "type": "string",
            "enum": [
              "demo",
              "custom"
            ],
            "title": "Family Mode",
            "default": "custom"
          },
          "starting_ages": {
            "items": {
              "type": "integer",
              "maximum": 100.0,
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 50,
            "title": "Starting Ages",
            "default": [
              8,
              6,
              4,
              2
            ]
          },
          "first_college_years": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "maximum": 2300.0,
                      "minimum": 1900.0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "First College Years"
          },
          "graduation_dates": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graduation Dates"
          },
          "college_annual": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "College Annual",
            "default": "50000"
          },
          "adult_support_enabled": {
            "type": "boolean",
            "title": "Adult Support Enabled",
            "default": true
          },
          "adult_minimum": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Adult Minimum",
            "default": "20000"
          },
          "adult_target": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Adult Target",
            "default": "200000"
          },
          "degree_years": {
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "multipleOf": 0.5,
                  "maximum": 100.0,
                  "exclusiveMinimum": 0.0
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "array",
            "maxItems": 50,
            "title": "Degree Years",
            "default": [
              "4",
              "4",
              "4",
              "4"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PaymentRequest"
      },
      "PortfolioEstimateRequest": {
        "properties": {
          "payment_inputs": {
            "$ref": "#/components/schemas/PaymentRequest"
